# ═══════════════════════════════════════════════════════════════
# Dhara News — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── LLM APIs (priority: Groq → Ollama → GitHub Models) ───────
# Groq (FREE, 14,400 req/day per key): https://console.groq.com
# Create separate accounts for each key to get independent quota pools.
# The system uses Least-RPM routing — requests automatically go to the
# key with the fewest requests in the current minute window.
#
# Numbered keys (GROQ_API_KEY_1 … 8) are loaded first.
# The legacy GROQ_API_KEY is still supported as a fallback for single-key setups.
#
# Recommended: 6–8 keys for launch (~370–500 fully-enriched articles/day).
# With summarization routed to Ollama: ~1,200–1,600 articles/day.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
# Legacy single-key (still works if numbered keys are blank)
GROQ_API_KEY=

# Groq rate-limit tuning
# GROQ_MAX_RPS: max requests per second per key (default: 10 — safe for free tier)
# GROQ_RETRIES: retry attempts before falling back to Ollama (default: 3)
GROQ_MAX_RPS=10
GROQ_RETRIES=3

# GitHub Models (Student pack, 500 req/day for Llama):
# Token from: github.com/settings/tokens → Models: Read
# NOTE: This is NOT GitHub Copilot — they have separate quotas
GITHUB_TOKEN=
GITHUB_MODEL=meta-llama-3.1-8b-instruct

# ── Web Push Notifications ────────────────────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@dhara.news

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # Same as VAPID_PUBLIC_KEY
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth (Supabase) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# Production: FRONTEND_ORIGIN=https://dhara.news
# Optional: comma-separated methods override. If blank, defaults are profile-based:
# production => GET,POST,PATCH,DELETE,OPTIONS
# development => GET,POST,PATCH,DELETE,PUT,OPTIONS
CORS_ALLOW_METHODS=

# ── Admin & Auth Guards (required in production) ─────────────
ADMIN_KEY=
# Supabase JWT secret used by backend for token signature verification.
SUPABASE_JWT_SECRET=

# ── Translation ───────────────────────────────────────────────
LIBRETRANSLATE_URL=http://libretranslate:5000

# ── Runtime Service URLs (Docker/local overrides) ───────────────────────────
PG_DSN=postgresql://dhara:dhara_local_dev@postgres:5432/dhara
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://dhara:dhara_local@rabbitmq:5672/
QDRANT_URL=http://qdrant:6333
ES_URL=http://elasticsearch:9200

# Docker infra credentials (override defaults in compose)
POSTGRES_PASSWORD=dhara_local_dev
RABBITMQ_DEFAULT_PASS=dhara_local
MINIO_ROOT_USER=dhara_minio
MINIO_ROOT_PASSWORD=dhara_minio_secret
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Rewrite Agent Controls ──────────────────────────────────────────────────
REWRITE_MIN_WORDS=650
REWRITE_MAX_WORDS=950
REWRITE_MAX_TOKENS=1400

# ── FCM Push (legacy, optional) ───────────────────────────────
FCM_SERVER_KEY=

# ── Email Digest (Brevo free tier: 300 emails/day) ───────────────────────────
# Sign up at brevo.com, generate API key from Settings → API Keys
BREVO_API_KEY=
DIGEST_FROM_EMAIL=brief@dhara.news
DIGEST_FROM_NAME=धारा Morning Brief

# ── Share as Image ────────────────────────────────────────────────────────────
# Pillow must be installed: pip install Pillow
# No config needed - auto-generates PNG cards for WhatsApp sharing

# ── Contact Form (Google Sheets) ─────────────────────────────────────────────
# See scripts/google-apps-script.js for setup instructions
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# ── Razorpay Payments ─────────────────────────────────────────────────────────
# Sign up at razorpay.com (free account)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook security:
# false (recommended): fail closed if webhook secret is missing.
# true (local/dev only): allow unsigned webhooks for manual testing.
ALLOW_INSECURE_WEBHOOKS=false

# Webhook receipt replay cleanup (days retained, cleanup interval in seconds)
WEBHOOK_RECEIPTS_TTL_DAYS=14
WEBHOOK_CLEANUP_INTERVAL_SECS=3600
