# ═══════════════════════════════════════════════════════════════
# Dhara News — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Environment & Secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env.local
frontend/.env.*.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ── Node.js / Next.js ────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────
# Ignore Docker data volumes (if mounted locally)
docker-data/
pgdata/
redis-data/
minio-data/
qdrant-data/
es-data/
ollama-data/

# ── IDE & Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build artifacts ───────────────────────────────────────────
*.chunk.js
*.bundle.js
